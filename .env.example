# API token shared between the app and the PowerContext server.
POWERCONTEXT_TOKEN=dev-token-change-me

# App
QA_APP_PORT=8080
QA_MAX_BYTES=1800
QA_REFUSAL_MIN_SCORE=0.0

# PowerContext server (pc service)
POWERCONTEXT_BASE_URL=http://pc:8000
POWERCONTEXT_SERVER_AUTH_ENABLED=true
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////data/powercontext.db

# Generation backend (set the one you actually use)
QA_MODEL_BASE_URL=
QA_MODEL_NAME=
QA_MODEL_API_KEY=
